# ===========================================
# ET-MCP — env for standalone MCP servers
# Copy to .env and fill required values
# No LLM key needed — MCP is just tools
# ===========================================

# --- Catalog DB (Supabase Postgres, read-only) ---
# Required for catalog tools (get_product, search_products, run_select).
# Site + Calc work without it.
# Use the Supabase "Session pooler" URI (Dashboard -> Connect -> Session pooler):
# db.<ref>.supabase.co is IPv6-only and times out on IPv4-only networks.
# Use a read-only role limited to the catalog schema, not the postgres superuser.
SUPABASE_DB_URL=postgresql://catalog_ro.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional explicit Session pooler URI; takes precedence over SUPABASE_DB_URL.
# Copy the actual hostname from Connect; do not derive it from the region.
SUPABASE_POOLER_DB_URL=
# Schema holding the catalog tables (search_path for every query).
CATALOG_SCHEMA=ragav
DB_STATEMENT_TIMEOUT_MS=8000
DB_ROW_LIMIT=500
# Drop list_price/price_usd from results and reject price queries.
# Set true when serving a customer-facing assistant that must not quote prices.
CATALOG_HIDE_PRICES=true

# --- Retrieval / Vector (optional) ---
# Local Qdrant dir auto-created at .qdrant_storage if QDRANT_URL empty/relative.
# First run downloads BAAI/bge-small-en-v1.5 (~40MB) — needs internet once.
QDRANT_URL=.qdrant_storage
# QDRANT_API_KEY=          # only for remote Qdrant Cloud
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL_NAME=BAAI/bge-base-en-v1.5

# --- Tuning (optional) ---
SITE_MIN_CONFIDENCE=0.35
# Site search is BM25 + keyword only (no embeddings).
DISABLE_SITE_VECTOR=true
# ENABLE_RERANKING_CALC=false
# ENABLE_RERANKING_CATALOG=false

# --- HTTP transport (optional) ---
# When bound to 127.0.0.1 only localhost Host headers are accepted. List the
# names other clients use (Docker service name, domain), comma-separated.
# MCP_ALLOWED_HOSTS=et-mcp:8001,mcp.example.com
