FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1
COPY mcp-server/pyproject.toml ./
COPY mcp-server/src ./src
RUN pip install --no-cache-dir . && useradd --create-home --uid 10001 service && mkdir .qdrant_storage && chown service:service .qdrant_storage
COPY deploy/service_auth.py deploy/mcp_gateway.py ./
USER service
CMD ["sh", "-c", "exec python -m uvicorn mcp_gateway:app --host 0.0.0.0 --port ${PORT:-10000}"]
