FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1
COPY pii-service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home --uid 10001 service
COPY pii-service/main.py ./
COPY deploy/service_auth.py deploy/pii_gateway.py ./
USER service
CMD ["sh", "-c", "exec python -m uvicorn pii_gateway:app --host 0.0.0.0 --port ${PORT:-10000}"]
